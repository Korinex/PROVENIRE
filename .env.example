# Required outside test mode. Generate a unique random value for local use.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# OAuth configuration is required only when enabling Manus sign-in.
OAUTH_SERVER_URL=
VITE_APP_ID=

# Optional comma-separated redirect origins, for example:
# OAUTH_ALLOWED_REDIRECT_ORIGINS=https://provenire.example,http://localhost:3000
OAUTH_ALLOWED_REDIRECT_ORIGINS=

PORT=3000# Required outside test mode. Generate a unique random value for local use.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# OAuth configuration is required only when enabling Manus sign-in.
OAUTH_SERVER_URL=
VITE_APP_ID=

# Optional comma-separated redirect origins, for example:
